# 복사 후 .env 로 저장하세요. 실제 비밀번호는 GitHub에 올리지 마세요.

GEMINI_API_KEY=

# 답글 톤: kind | polite | firm | short
REPLY_TONE=polite
STORE_GUIDE=떡볶이 맛집, 서비스 음료를 정중히 언급

# 브라우저 (true 면 화면 표시 — OTP/캡차 직접 처리)
HEADFUL=true
SLOW_MO_MS=80
TYPE_DELAY_MS=90
MAX_REPLIES_PER_PLATFORM=10
MANUAL_AUTH_WAIT_SEC=120

BAEMIN_ID=
BAEMIN_PW=

COUPANG_ID=
COUPANG_PW=

YOGIYO_ID=
YOGIYO_PW=

DDANGYO_ID=
DDANGYO_PW=

SPECIAL_ID=
SPECIAL_PW=
